# GitHub Actions 워크플로 (사용 대기 템플릿)
#
# 이 파일은 .github/workflows/ci.yml 의 원본 내용입니다. 현재 GitHub 연결(Pickle GitHub App)에
# workflows 쓰기 권한이 없어 이 경로에 둘 수 없었습니다. GitHub 웹에서 이 파일을
# .github/workflows/ci.yml 로 옮기면(내용 그대로) 다음 푸시부터 CI가 자동으로 돕니다.

name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["3.10", "3.11", "3.12"]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - name: Install
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
      - name: Unit and integration tests
        run: python -m pytest -q
      - name: CLI smoke test (recommend -> formulate -> xlsx)
        run: |
          python -m olfactra_core recommend --mood calm --space study --style green --limit 1
          python -m olfactra_core formulate --product edp --volume 50 --load 20 \
            --accord "linalool=40,geraniol=25,phenylethyl alcohol=25,cedrol=10" --out recipe.xlsx
          python -m olfactra_core demo --out demo-out
      - name: Licence and boundary files present
        run: |
          test -f LICENSE && grep -q "MIT License" LICENSE
          test -f NOTICE.md && grep -q "safety" NOTICE.md
